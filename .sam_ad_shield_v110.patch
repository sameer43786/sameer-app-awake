+package com.sameerali.samadshield;
+
+import android.accessibilityservice.AccessibilityService;
+import android.view.accessibility.AccessibilityEvent;
+import android.view.accessibility.AccessibilityNodeInfo;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Event-driven YouTube helper.
+ *
+ * YouTube serves much of its advertising from the same first-party infrastructure
+ * used for normal video, so a DNS blocker cannot safely block those hosts without
+ * also breaking playback. This optional AccessibilityService uses a different,
+ * low-power approach: when YouTube itself exposes a real "Skip ad" control, the
+ * service clicks that control immediately. It does not modify YouTube, inspect TLS,
+ * read typed text, or perform continuous polling.
+ */
+public final class YouTubeAdAssistService extends AccessibilityService {
+    private static final String YOUTUBE_PACKAGE = "com.google.android.youtube";
+    private static final long MIN_SCAN_INTERVAL_MS = 120L;
+
+    private long lastScanMs = 0L;
+
+    private static final String[] SKIP_RESOURCE_IDS = {
+            "com.google.android.youtube:id/skip_ad_button",
+            "com.google.android.youtube:id/skip_ad_button_text",
+            "com.google.android.youtube:id/ad_skip_button",
+            "com.google.android.youtube:id/ad_skip_button_container",
+            "com.google.android.youtube:id/modern_skip_ad_button",
+            "com.google.android.youtube:id/skip_button"
+    };
+
+    private static final String[] CLOSE_RESOURCE_IDS = {
+            "com.google.android.youtube:id/ad_close_button",
+            "com.google.android.youtube:id/companion_ad_close_button",
+            "com.google.android.youtube:id/close_ad"
+    };
+
+    private static final List<String> SKIP_PHRASES = Arrays.asList(
+            "skip ad", "skip ads",
+            "saltar anuncio", "saltar anuncios",
+            "omitir anuncio", "omitir anuncios",
+            "anzeige überspringen", "anzeigen überspringen",
+            "passer l'annonce", "ignorer l'annonce",
+            "salta annuncio", "salta annunci",
+            "pular anúncio", "pular anúncios",
+            "広告をスキップ", "跳过广告", "跳過廣告"
+    );
+
+    private static final List<String> CLOSE_PHRASES = Arrays.asList(
+            "close ad", "close advertisement",
+            "cerrar anuncio", "fermer l'annonce",
+            "anzeige schließen", "chiudi annuncio",
+            "fechar anúncio", "広告を閉じる", "关闭广告", "關閉廣告"
+    );
+
+    @Override
+    public void onAccessibilityEvent(AccessibilityEvent event) {
+        if (event == null || event.getPackageName() == null) return;
+        if (!YOUTUBE_PACKAGE.contentEquals(event.getPackageName())) return;
+
+        long now = android.os.SystemClock.elapsedRealtime();
+        if (now - lastScanMs < MIN_SCAN_INTERVAL_MS) return;
+        lastScanMs = now;
+
+        AccessibilityNodeInfo root = getRootInActiveWindow();
+        if (root == null) return;
+
+        try {
+            if (clickKnownResource(root, SKIP_RESOURCE_IDS)) return;
+            if (clickPhrase(root, SKIP_PHRASES)) return;
+            if (clickKnownResource(root, CLOSE_RESOURCE_IDS)) return;
+            clickPhrase(root, CLOSE_PHRASES);
+        } finally {
+            root.recycle();
+        }
+    }
+
+    private boolean clickKnownResource(AccessibilityNodeInfo root, String[] ids) {
+        for (String id : ids) {
+            List<AccessibilityNodeInfo> nodes;
+            try {
+                nodes = root.findAccessibilityNodeInfosByViewId(id);
+            } catch (Exception ignored) {
+                continue;
+            }
+            if (nodes == null) continue;
+            for (AccessibilityNodeInfo node : nodes) {
+                try {
+                    if (clickNodeOrParent(node)) return true;
+                } finally {
+                    if (node != null) node.recycle();
+                }
+            }
+        }
+        return false;
+    }
+
+    private boolean clickPhrase(AccessibilityNodeInfo root, List<String> phrases) {
+        ArrayList<AccessibilityNodeInfo> stack = new ArrayList<>();
+        stack.add(root);
+        int visited = 0;
+
+        while (!stack.isEmpty() && visited < 300) {
+            AccessibilityNodeInfo node = stack.remove(stack.size() - 1);
+            visited++;
+
+            if (node != root && matches(node, phrases)) {
+                if (clickNodeOrParent(node)) return true;
+            }
+
+            int children = node.getChildCount();
+            for (int i = 0; i < children; i++) {
+                AccessibilityNodeInfo child = node.getChild(i);
+                if (child != null) stack.add(child);
+            }
+
+            if (node != root) node.recycle();
+        }
+
+        // Recycle anything left if the visit cap was reached.
+        for (AccessibilityNodeInfo node : stack) {
+            if (node != null && node != root) node.recycle();
+        }
+        return false;
+    }
+
+    private static boolean matches(AccessibilityNodeInfo node, List<String> phrases) {
+        String text = normalize(node.getText());
+        String desc = normalize(node.getContentDescription());
+        if (text.isEmpty() && desc.isEmpty()) return false;
+
+        for (String phrase : phrases) {
+            String p = phrase.toLowerCase(Locale.ROOT);
+            if (text.equals(p) || desc.equals(p) || text.contains(p) || desc.contains(p)) return true;
+        }
+        return false;
+    }
+
+    private static String normalize(CharSequence value) {
+        if (value == null) return "";
+        return value.toString().trim().toLowerCase(Locale.ROOT);
+    }
+
+    private static boolean clickNodeOrParent(AccessibilityNodeInfo node) {
+        AccessibilityNodeInfo current = node;
+        for (int depth = 0; current != null && depth < 5; depth++) {
+            if (current.isVisibleToUser() && current.isEnabled() && current.isClickable()) {
+                return current.performAction(AccessibilityNodeInfo.ACTION_CLICK);
+            }
+            AccessibilityNodeInfo parent = current.getParent();
+            if (current != node) current.recycle();
+            current = parent;
+        }
+        if (current != null && current != node) current.recycle();
+        return false;
+    }
+
+    @Override
+    public void onInterrupt() {
+        // No continuous work to stop; all behavior is event-driven.
+    }
+}
